---
/**
 * BaseLayout — shared HTML shell for every page.
 *
 * Owns: <head> (meta, fonts, favicon), global styles + tokens, the lang attribute,
 * and chrome slots that Plan 02 fills (nav / footer / floating CTA). Film-grain comes
 * from global.css — do NOT duplicate it here.
 */
import type { Lang } from '../i18n/ui';
import { ClientRouter } from 'astro:transitions';
import '../styles/theme.css';
import '../styles/global.css';
import '../styles/chrome.css';
import '../styles/motion.css';
import '../styles/choreography.css';
import '../styles/transitions.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import DiscordModal from '../components/DiscordModal.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /**
   * Optional per-page robots directive rendered into <head> (e.g. "noindex,follow"
   * for the unlisted editors directory — D-16). Omitted pages get no robots meta and
   * remain indexable by default. Head placement is required: crawlers ignore a robots
   * meta found in <body>.
   */
  robots?: string;
}

const { lang, title, description, robots } = Astro.props;

/**
 * D-17 glitch-wipe: a quick (~0.26s) digital wipe with a red-fringe RGB-split that
 * echoes the hero shader (one motif). Applied to the <main> page wrapper only, so the
 * nav / footer / FloatingCTA (siblings of the wrapper) stay put across navigation — the
 * Abrir Ticket CTA never wipes (T-02-CTA). steps() easing reads as glitch, not a smooth
 * fade. Under reduced-motion the keyframes collapse to a plain opacity fade (transitions.css).
 */
const glitchStep = { duration: '0.26s', easing: 'steps(6, end)', fillMode: 'both' as const };
const glitchPair = {
  old: [{ name: 'glitch-out', ...glitchStep }],
  new: [{ name: 'glitch-in', ...glitchStep, delay: '0.04s' }],
};
const glitchWipe = { forwards: glitchPair, backwards: glitchPair };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0c14" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    {/* Preload the graffiti display font so it arrives within the font-display:block
        window (global.css) — kills the flash-of-fallback swap on the landing. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/a-another-tag.woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Inter:wght@300;400&family=Space+Grotesk:wght@700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <!-- Global chrome (top): fixed nav, language switcher, Discord CTA. -->
    <Nav lang={lang} />
    <slot name="chrome-top" />

    <!-- Page content wrapper carries the D-17 glitch-wipe view-transition. Nav/footer/CTA
         live OUTSIDE it so they persist (and stay clickable) across navigations. -->
    <main transition:animate={glitchWipe}>
      <slot />
    </main>

    <!-- Global chrome (bottom): footer, floating CTA, shared Discord modal. -->
    <slot name="chrome-bottom" />
    <Footer lang={lang} />
    <FloatingCTA lang={lang} />
    <DiscordModal lang={lang} />

    <!-- Film-static burst overlay for the D-17 page-transition (reads as intentional
         analog static, not a render error — user feedback 02.1-02). pointer-events:none
         and below the nav/CTA z-index so the conversion path is never blocked. -->
    <div class="glitch-static" aria-hidden="true" transition:persist></div>

    <script>
      // Flag <html> while a view-transition navigation is in flight so the
      // .glitch-static overlay flickers for that window only. The burst itself is
      // disabled under reduced-motion via CSS; the flag is harmless if events
      // never fire (e.g. ClientRouter unsupported).
      const root = document.documentElement;
      const flagOn = () => root.classList.add('is-navigating');
      const flagOff = () =>
        window.setTimeout(() => root.classList.remove('is-navigating'), 360);
      document.addEventListener('astro:before-preparation', flagOn);
      document.addEventListener('astro:after-swap', flagOff);
    </script>

    <script>
      import '../scripts/chrome.ts';
    </script>
    <script>
      import '../scripts/motion/index.ts';
    </script>
    <script>
      import '../scripts/sfx.ts';
    </script>
  </body>
</html>
