---
/**
 * Localized page resolver (CHANGE 3).
 *
 * Emits the per-locale slug for each non-home page concept from the central
 * route map (src/i18n/routes.ts):
 *   services → /es/servicios · /en/services
 *   gallery  → /es/galeria   · /en/gallery
 *   terms    → /es/terminos  · /en/terms
 *
 * One static file emits both locales' distinct slugs via getStaticPaths, so the
 * URL itself differs per locale instead of a shared filename. The concept is
 * recovered from (lang, slug) and used to pick meta + body. Chrome inherited
 * from BaseLayout — no per-page wiring.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicesPage from '../../components/sections/ServicesPage.astro';
import GalleryPage from '../../components/sections/GalleryPage.astro';
import StorePage from '../../components/sections/StorePage.astro';
import TermsPage from '../../components/sections/TermsPage.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import CartPill from '../../components/CartPill.astro';
import CartSummaryModal from '../../components/CartSummaryModal.astro';
import QuickViewModal from '../../components/QuickViewModal.astro';
import { toLang, useTranslations } from '../../i18n/ui';
import { staticPathsForConcept, conceptForSlug } from '../../i18n/routes';
import '../../styles/sections.css';
import '../../styles/terms.css';

export function getStaticPaths() {
  return [
    ...staticPathsForConcept('services'),
    ...staticPathsForConcept('gallery'),
    ...staticPathsForConcept('store'),
    ...staticPathsForConcept('terms'),
  ];
}

const lang = toLang(Astro.params.lang);
const slug = Astro.params.page ?? '';
const concept = conceptForSlug(lang, slug);

const pages = useTranslations(lang, 'pages');
const terms = useTranslations(lang, 'terms');

let meta: { title: string; description: string };
if (concept === 'gallery') {
  meta = { title: pages.galeria.metaTitle, description: pages.galeria.metaDescription };
} else if (concept === 'store') {
  meta = { title: pages.tienda.metaTitle, description: pages.tienda.metaDescription };
} else if (concept === 'terms') {
  meta = { title: terms.metaTitle, description: terms.metaDescription };
} else {
  meta = { title: pages.servicios.metaTitle, description: pages.servicios.metaDescription };
}
---

<BaseLayout lang={lang} title={meta.title} description={meta.description}>
  {concept === 'gallery' && <GalleryPage lang={lang} />}
  {concept === 'store' && <StorePage lang={lang} />}
  {concept === 'terms' && <TermsPage lang={lang} />}
  {concept === 'services' && <ServicesPage lang={lang} />}

  {/* Cart/quote overlays live in the body-level chrome-bottom slot (OUTSIDE <main>)
      so the drawer + backdrop escape main's view-transition stacking context and
      layer above the fixed nav + FloatingCTA — same placement as DiscordModal. */}
  {concept === 'services' && (
    <Fragment slot="chrome-bottom">
      <CartDrawer lang={lang} />
      <CartPill lang={lang} />
      <CartSummaryModal lang={lang} />
    </Fragment>
  )}

  {/* Store quick-view modal — mounted in the body-level chrome-bottom slot so the
      dc-overlay escapes <main>'s view-transition stacking context (mirrors the
      services cart placement). Store-only; the purchase cart arrives in Plan 03. */}
  {concept === 'store' && (
    <Fragment slot="chrome-bottom">
      <QuickViewModal lang={lang} />
    </Fragment>
  )}
</BaseLayout>
