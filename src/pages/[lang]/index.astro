---
/**
 * Localized landing hero (NAV-01, I18N-02/I18N-03).
 *
 * Renders the migrated + polished hero from per-language dictionaries.
 * Both /es/ and /en/ are statically generated. The WebGL shader is a Phase-2
 * layer that will mount over the static hero-bg; `reveal` hooks stay inert here.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langCodes, toLang, useTranslations } from '../../i18n/ui';
import About from '../../components/sections/About.astro';
import FeaturedGallery from '../../components/sections/FeaturedGallery.astro';
import PackagesSummary from '../../components/sections/PackagesSummary.astro';
import Reviews from '../../components/sections/Reviews.astro';
import { localizedPath } from '../../i18n/routes';
import '../../styles/sections.css';
import '../../styles/hero-shader.css';

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang, 'home');
const empty = useTranslations(lang, 'pages').emptyState;
---

<BaseLayout lang={lang} title={t.metaTitle} description={t.metaDescription}>
  <section id="home" class="hero">
    <div class="hero-bg" aria-hidden="true">
      <!-- Default-visible static fallback (D-04/D-20): the hero background with
           JS off, before the shader confirms it is live, or on any degradation.
           The shader (Plan 02-02) reveals its canvas and retires this <img> by
           toggling data-shader-live on .hero-bg once it renders a frame. -->
      <img
        class="hero-fallback"
        src="/hero-fallback.avif"
        alt=""
        aria-hidden="true"
        decoding="async"
        fetchpriority="high"
        data-hero-fallback
      />
      <!-- WebGL2 glitch shader mount point — stays empty/hidden until live. -->
      <canvas data-hero-shader aria-hidden="true"></canvas>
      <!-- Contrast/vignette legibility guard so headline + CTA hold AA (D-04). -->
      <div class="hero-shader-overlay"></div>
      <div class="hero-grid"></div>
      <div class="hero-glow"></div>
    </div>
    <div class="hero-content">
      <p class="hero-eyebrow reveal">{t.eyebrow}</p>
      <span class="hero-wordmark reveal">{t.brandWordmark}</span>
      <h1 class="hero-title">
        <span class="hero-title-line reveal">{t.taglineA}</span>
        <span class="hero-title-line reveal">{t.taglineB}</span>
      </h1>
      <div class="hero-services reveal">
        {
          t.services.map((service, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">✦</span>}
              <span>{service}</span>
            </>
          ))
        }
      </div>
      <div class="hero-ctas reveal">
        <button class="hero-cta dc-trigger" type="button">
          {t.ctaPrimary}
        </button>
        <a href={localizedPath('services', lang)} class="hero-cta hero-cta--outline">{t.ctaSecondary}</a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true">
      <span>{t.scrollCue}</span>
      <div class="hero-scroll-line"></div>
    </div>
  </section>

  <!-- Visual-first landing order (D-12): hero → featured gallery → about+process
       → packages summary → reviews → closing. The featured teaser is raised to #2
       to impress before the about/process. Reviews (07-01) is social proof adjacent
       to the conversion path. Ink/paper rhythm alternates: featured(ink) →
       about(paper) → packages(ink) → reviews(paper, delineated by the .section--rule
       hairline; renders NOTHING when reviews.json is empty) → closing(ink). -->
  <FeaturedGallery lang={lang} />
  <About lang={lang} surface />
  <PackagesSummary lang={lang} />
  <Reviews lang={lang} />

  <section class="section section--rule">
    <div class="closing reveal">
      <div class="section-header" style="margin-bottom: 0;">
        <span class="section-tag">{t.closingTag}</span>
        <h2 class="section-title">{t.taglineA}</h2>
        <p class="section-subtitle">{empty.serviciosBody}</p>
      </div>
      <div class="closing-cta">
        <button type="button" class="btn-primary dc-trigger">{t.ctaPrimary}</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero — Refined Street Editorial (D-04/D-05/D-11). Clean editorial composition:
     Space Grotesk tagline is the headline, the graffiti "Nocturna" wordmark is the
     signature accent, the retained shader/grid is a decorative ink backdrop that
     never gates legibility. The old busy hero treatment is fully removed. */
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    background: var(--color-ink);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
  }
  /* Subtle editorial grid backdrop (decorative only). */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(240, 234, 228, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(240, 234, 228, 0.03) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 90% 80% at 50% 50%, black 30%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 50%, black 30%, transparent 78%);
  }
  /* Legibility guard — a flat ink scrim so the headline + CTA always hold AA over
     the decorative shader/grid backdrop (D-11). */
  .hero-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--color-ink) 0%,
      color-mix(in srgb, var(--color-ink) 78%, transparent) 55%,
      color-mix(in srgb, var(--color-ink) 40%, transparent) 100%
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    text-align: left;
    z-index: 2;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: calc(var(--nav-h) + var(--space-2xl)) var(--page-gutter) var(--space-2xl);
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.4vw, 13px);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-red-on-ink);
    margin-bottom: var(--space-lg);
  }

  /* Graffiti wordmark — signature accent ONLY (D-05). Large display type that stands
     out by its own searchlights + color, so it carries the hero even over a darker
     field. Rendered in the darker wordmark red (closer to brand red, 3.61:1 on ink —
     clears the large-text 3:1 bar; the glow on top keeps it popping). */
  .hero-wordmark {
    position: relative;
    display: inline-block;
    font-family: var(--font-tag);
    font-size: clamp(76px, 16.5vw, 248px);
    line-height: 0.84;
    letter-spacing: 3px;
    color: var(--color-red-wordmark);
    margin-bottom: var(--space-md);
  }
  /* ONE restrained atmospheric touch: a soft, slow-drifting red haze behind the
     wordmark — a single GPU-composited radial-gradient layer (opacity/transform
     only, cheap). It gives the signature a glow without a heavy text-shadow and
     makes the red read warmer. Disabled under reduced-motion below. */
  .hero-wordmark::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 150%;
    height: 220%;
    transform: translate3d(-50%, -50%, 0);
    background: radial-gradient(
      ellipse 50% 50% at 50% 50%,
      color-mix(in srgb, var(--color-red-glow) 50%, transparent) 0%,
      transparent 70%
    );
    filter: blur(34px);
    pointer-events: none;
    z-index: -1;
    animation: hero-haze-drift 9s ease-in-out infinite alternate;
  }
  @keyframes hero-haze-drift {
    0% {
      transform: translate3d(-52%, -50%, 0) scale(1);
      opacity: 0.75;
    }
    100% {
      transform: translate3d(-48%, -52%, 0) scale(1.08);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-wordmark::before {
      animation: none;
    }
  }

  /* Tagline = the editorial headline, Space Grotesk. Trimmed a notch and given
     looser tracking + line-height so it feels editorial, not square/blocky (D-04). */
  .hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 6vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--color-white);
    margin-bottom: var(--space-xl);
  }
  .hero-title-line {
    display: block;
  }

  .hero-services {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-white-dim);
    margin-bottom: var(--space-xl);
  }
  .hero-services .sep {
    color: var(--color-red);
    font-size: 8px;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-white);
    background: var(--color-red);
    border: 1px solid var(--color-red);
    border-radius: 999px;
    padding: 14px 32px;
    /* transition delegated to choreography.css — no local override so the
       choreography module's hover lift is not silenced by scoped specificity (CR-04). */
  }
  /* .hero-cta:hover and transition are intentionally absent here — choreography.css
     is the single source of truth for the hover lift and transition contract (CR-04). */
  .hero-cta--outline {
    background: transparent;
    color: var(--color-white);
  }
  .hero-cta--outline:hover {
    background: var(--color-red);
    border-color: var(--color-red);
  }

  @media (max-width: 768px) {
    .hero-glow {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-ink) 55%, transparent) 0%,
        var(--color-ink) 70%
      );
    }
  }

  .hero-scroll {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    z-index: 4;
  }
  .hero-scroll span {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-white-dim);
  }
  .hero-scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--color-red), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%,
    100% {
      opacity: 0.3;
      transform: scaleY(0.6);
    }
    50% {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line {
      animation: none;
    }
  }
</style>
