---
/**
 * Legacy per-editor route → static-host redirect stub (D-14, Wave-3 cutover).
 *
 * The canonical editor page now lives at the single-language vanity URL `/e/<slug>`
 * (plan 10.1-07 Task 1). This file used to RENDER the profile; it is now a tiny
 * redirect shell so every already-shared bilingual URL — `/es/editores/<slug>` and
 * `/en/editors/<slug>` — still resolves and forwards to `/e/<slug>` on a static host
 * (GitHub Pages, no server-side 301).
 *
 * getStaticPaths is UNCHANGED in shape: it still emits the cartesian of published
 * editors × langCodes with the localized `concept` directory slug, so BOTH legacy
 * locale URLs keep resolving to a stub page (a dropped page would 404 old links).
 * The read stays defensive (copy-before-filter, published + string-slug guard) so one
 * malformed/unpublished entry never breaks the whole-site build (T-10.1-07-04).
 *
 * Redirect security (T-01-03 / T-10.1-07-02): the redirect target is a BUILD-TIME
 * per-page literal `/e/<slug>` — the slug is baked into the stub at build time via
 * `define:vars` (serialized as a JSON string literal), NEVER read from a runtime value
 * inside the inline script. The path prefix is a fixed literal, so the target is always
 * same-origin `/e/…` and there is no open-redirect surface. The slug charset is
 * constrained upstream (editors_model normalize_slug), but it is still emitted only as
 * a build-time literal here. This mirrors the root index.astro redirect shell.
 */
import { langCodes } from '../../../i18n/ui';
import { routeSlugs } from '../../../i18n/routes';
import type { Editor } from '../../../lib/editorTypes';
import editorsData from '../../../data/editors.json';

export function getStaticPaths() {
  // Copy-before-filter (never mutate the imported module array); keep only
  // publishable entries so a bad/unpublished row can't break the build.
  const raw: Editor[] = Array.isArray(editorsData) ? ([...editorsData] as Editor[]) : [];
  const published = raw.filter(
    (e) =>
      Boolean(e) &&
      e.published === true &&
      typeof e.slug === 'string' &&
      e.slug.length > 0,
  );
  // Cartesian: one stub per published editor per locale, so every legacy
  // `/es/editores/<slug>` and `/en/editors/<slug>` URL still resolves.
  return published.flatMap((editor) =>
    langCodes.map((lang) => ({
      params: { lang, concept: routeSlugs.editors[lang], slug: editor.slug },
    })),
  );
}

// Build-time literals (known per generated page). The target is assembled here and
// baked into the stub — the inline script never reads a runtime value (T-01-03).
const { lang, slug } = Astro.params;
const target = `/e/${slug}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0c14" />
    <!-- Old URL must not be indexed; the canonical points search engines at /e/<slug>. -->
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <title>Nocturna Avatars</title>
    <!-- No-JS fallback: a meta-refresh forwards to the vanity URL. -->
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${target}`} />
    </noscript>
    <!-- JS path: `target` is injected as a build-time JSON string literal via
         define:vars — the script never reads Astro.params or any runtime value. -->
    <script define:vars={{ target }}>
      location.replace(target);
    </script>
  </head>
  <body></body>
</html>
