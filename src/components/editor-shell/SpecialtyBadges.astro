---
/**
 * SpecialtyBadges — the editor's specialty pills, FREE-FORM text (loosened from
 * the old D-07 curated set on user request: not everyone is an "editor" — modelers,
 * managers, etc. — so a fixed allowlist no longer fits).
 *
 * Values are now arbitrary strings, kept safe the same way the bot validates them
 * (`nocturna-bot/core/editors_model.py` `_badges_free_text`): each tag is trimmed,
 * empties dropped, capped at 40 chars, de-duped (case-insensitive), and at most 10
 * render. Labels go through Astro `{}` auto-escaping ONLY (never a raw-HTML
 * directive, D-02), so a tag can never carry injected markup — the render-side half
 * of the defense. A couple of legacy keys keep their nicer display label.
 *
 * Pill styling reads `--theme-*` tokens only (no brand `--color-*`), so it recolours
 * with the page theme. When the list is empty the component renders NOTHING (no empty
 * rail — UI-SPEC minimal-state rule).
 */
interface Props {
  badges: string[];
}

// Legacy curated keys keep a nicer display label; any other value renders verbatim.
const LEGACY_LABELS: Record<string, string> = {
  Modeling3D: '3D Modeling',
};

const { badges } = Astro.props;
const input = Array.isArray(badges) ? badges : [];
// Trim, drop empties/over-long, de-dupe (case-insensitive), preserve order, cap at 10.
const seen = new Set<string>();
const tags: string[] = [];
for (const raw of input) {
  if (typeof raw !== 'string') continue;
  const tag = raw.trim();
  if (!tag || tag.length > 40) continue;
  const key = tag.toLowerCase();
  if (seen.has(key)) continue;
  seen.add(key);
  tags.push(LEGACY_LABELS[tag] ?? tag);
  if (tags.length >= 10) break;
}
---

{tags.length > 0 && (
  <ul class="editor-badges" aria-label="Specialties">
    {tags.map((tag) => (
      <li class="editor-badges__pill">{tag}</li>
    ))}
  </ul>
)}

<style>
  /* Pill rail — mirrors the PortfolioBlock credited-badge rhythm, recoloured to
     theme tokens (no brand --color-*). Accent-tinted surface + accent hairline. */
  .editor-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .editor-badges__pill {
    padding: var(--space-3xs) var(--space-xs);
    background: color-mix(in srgb, var(--theme-accent) 14%, var(--theme-surface));
    border: 1px solid color-mix(in srgb, var(--theme-accent) 40%, transparent);
    border-radius: 999px;
    color: var(--theme-text);
    font-family: var(--theme-font);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }
</style>
