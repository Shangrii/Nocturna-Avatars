---
/**
 * ViewCounter — self-hosted cinema view-count ping (D-25).
 *
 * Hidden by default; `viewcounter.ts` pings the cinema endpoint ONCE on the
 * `editor:enter` splash-dismiss event and reveals the returned count via
 * textContent only. On any failure the element stays hidden with no error text
 * (Copywriting Contract). Micro (12px) type role; the eye icon uses --theme-accent.
 * Renders nothing without a slug.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

{
  slug && (
    <span class="editor-views" data-viewcount data-slug={slug} hidden>
      <svg
        class="editor-views__icon"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8" />
      </svg>
      <span class="editor-views__count" data-viewcount-n aria-live="polite" />
    </span>
  )
}

<style>
  /* Fixed top-left Material pill (mirrors the Spotify widget top-right): neutral dark
     glass, theme-independent so it reads on any background. */
  .editor-views {
    position: fixed;
    top: var(--space-sm);
    left: var(--space-sm);
    z-index: 900; /* under the splash (1000); appears after entering */
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px 7px 11px;
    border-radius: 999px;
    background: rgba(18, 20, 28, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 22px -12px rgba(0, 0, 0, 0.7);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    backdrop-filter: blur(12px) saturate(1.2);
    font-family: var(--theme-font);
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    color: #f0eae4;
  }
  /* `hidden` must win — the display above would otherwise override the UA rule and show
     an empty pill before the count loads / on failure (viewcounter.ts reveals on success). */
  .editor-views[hidden] {
    display: none;
  }
  .editor-views__icon {
    flex-shrink: 0;
    color: var(--theme-accent);
  }
  .editor-views__count {
    letter-spacing: 0.02em;
  }
</style>

<script>
  import '../../scripts/editor/viewcounter.ts';
</script>
