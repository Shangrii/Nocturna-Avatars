---
/**
 * Splash — the click-to-enter gate every editor page opens with (D-22).
 *
 * A fixed full-viewport overlay showing a blurred peek of the themed background,
 * the editor NAME (Display role, `var(--theme-font)`), and a device-aware hint.
 * The ENTIRE overlay is the enter affordance — there is no button (design call):
 * it is a single `role="button"` surface, so clicking/tapping anywhere (or Enter /
 * Space / Escape) dismisses it. Its whole job is to gate autoplay: the paired
 * `splash.ts` dispatches `editor:enter` once on dismiss (the unlock signal plan 04's
 * audio + view-counter consume) and starts the background video. Copy renders in the
 * editor's ONE language (D-13).
 *
 * XSS: the name renders through Astro `{}` auto-escaping only — never a raw-HTML
 * directive (T-10.1-06-02).
 */
interface Props {
  name: string;
  lang?: 'es' | 'en';
}

const { name, lang = 'es' } = Astro.props;

/* Copywriting Contract: device-aware enter hint + accessible label, per editor lang. */
const copy = {
  es: { touch: 'Toca para entrar', desktop: 'Haz clic para entrar', aria: `Entrar a la página de ${name}` },
  en: { touch: 'Tap to enter', desktop: 'Click to enter', aria: `Enter ${name}’s page` },
}[lang];
---

<div
  class="editor-splash"
  data-splash
  role="button"
  tabindex="0"
  aria-label={copy.aria}
>
  <div class="editor-splash__inner">
    <p class="editor-splash__name">{name}</p>
    <p class="editor-splash__hint" aria-hidden="true">
      <span class="editor-splash__hint--desktop">{copy.desktop}</span>
      <span class="editor-splash__hint--touch">{copy.touch}</span>
    </p>
  </div>
</div>

<style>
  /* Full-viewport gate — the ENTIRE surface is the enter affordance (no button). */
  .editor-splash {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
    background: rgba(0, 0, 0, 0.4);
    -webkit-backdrop-filter: blur(22px) saturate(1.1);
    backdrop-filter: blur(22px) saturate(1.1);
    opacity: 1;
    cursor: pointer;
    transition: opacity 0.5s ease;
  }
  /* Inset focus ring for keyboard users (the element itself fills the viewport). */
  .editor-splash:focus-visible {
    outline: 2px solid var(--theme-text);
    outline-offset: -8px;
  }
  /* Static fallback where backdrop-filter is unsupported: a solid-ish scrim peek. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .editor-splash {
      background: color-mix(in srgb, var(--theme-bg) 82%, black);
    }
  }
  .editor-splash.is-leaving {
    opacity: 0;
  }
  .editor-splash[hidden] {
    display: none;
  }

  .editor-splash__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    text-align: center;
  }

  /* Display role: 32px (clamp 28–40) / 700 / 1.1 in the editor font. */
  .editor-splash__name {
    margin: 0;
    max-width: 90vw;
    font-family: var(--theme-font);
    font-size: clamp(28px, 8vw, 40px);
    font-weight: 700;
    line-height: 1.1;
    color: var(--theme-text);
    word-break: break-word;
  }

  /* Micro role: the only interactivity cue now that there's no button. A subtle
     letter-spaced, muted hint with a slow breathing pulse so the surface reads as
     "click anywhere". Uppercase + tracking gives it the premium link-in-bio feel. */
  .editor-splash__hint {
    margin: 0;
    font-family: var(--theme-font);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--theme-text-muted);
    animation: editor-splash-breathe 2.6s ease-in-out infinite;
  }
  @keyframes editor-splash-breathe {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }
  .editor-splash__hint--touch {
    display: none;
  }
  @media (hover: none), (pointer: coarse) {
    .editor-splash__hint--desktop {
      display: none;
    }
    .editor-splash__hint--touch {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editor-splash {
      transition: none;
    }
    .editor-splash__hint {
      animation: none;
      opacity: 0.85;
    }
  }
</style>
