---
/**
 * SpotifyVinyl — a static picked-track mini player with the album art on a spinning
 * vinyl (Material-style card). The page stores ONLY the track URL; `spotify.ts`
 * resolves album art + title client-side via Spotify's CORS-open oEmbed and drives
 * playback through Spotify's official IFrame API (graceful link fallback).
 *
 * Renders NOTHING without a valid open.spotify.com/track/ URL. Starts `hidden` and is
 * revealed by the script only once oEmbed resolves, so a dead/removed track shows no
 * empty card. Theme-independent neutral dark surface (like the AudioPlayer) so it reads
 * on any background.
 */
interface Props {
  url?: string | null;
  start?: number;
}
const { url, start = 0 } = Astro.props;
const clean =
  typeof url === 'string' && /^https:\/\/open\.spotify\.com\/(?:intl-[a-z]{2}\/)?track\//.test(url)
    ? url
    : '';
const startAt = Number.isFinite(start) ? Math.max(0, Math.round(start)) : 0;
---

{
  clean && (
    <section class="spotify-vinyl" data-spotify data-spotify-url={clean} data-spotify-start={startAt} hidden aria-label="Música">
      <div class="spotify-vinyl__disc" data-spotify-disc aria-hidden="true">
        <span class="spotify-vinyl__art" data-spotify-art />
      </div>

      <span class="spotify-vinyl__title" data-spotify-title />

      <button class="spotify-vinyl__play" data-spotify-play type="button" aria-pressed="false" aria-label="Reproducir / pausar">
        <svg class="spotify-vinyl__ico spotify-vinyl__ico--play" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" fill="currentColor" />
        </svg>
        <svg class="spotify-vinyl__ico spotify-vinyl__ico--pause" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor" />
        </svg>
      </button>

    </section>
  )
}

<style>
  /* Discreet fixed pill, top-right. */
  .spotify-vinyl {
    position: fixed;
    top: var(--space-sm);
    right: var(--space-sm);
    z-index: 900; /* under the splash (1000); appears after entering */
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: min(270px, calc(100vw - 2 * var(--space-sm)));
    padding: 8px 14px 8px 8px;
    border-radius: 999px;
    /* Neutral dark glass — theme-independent, reads on any background. */
    background: rgba(18, 20, 28, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 22px -12px rgba(0, 0, 0, 0.7);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    backdrop-filter: blur(12px) saturate(1.2);
    color: #f0eae4;
  }
  .spotify-vinyl[hidden] {
    display: none;
  }

  /* ── The vinyl record ─────────────────────────────────────────────────── */
  .spotify-vinyl__disc {
    position: relative;
    flex: 0 0 auto;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    /* Black disc + concentric grooves. */
    background:
      repeating-radial-gradient(circle at 50% 50%, #0b0b0d 0 1.5px, #1a1a1e 1.5px 3px),
      #121214;
    box-shadow:
      0 4px 14px -4px rgba(0, 0, 0, 0.8),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    animation: spotify-spin 8s linear infinite;
    animation-play-state: paused; /* runs only while playing */
  }
  .spotify-vinyl[data-playing='true'] .spotify-vinyl__disc {
    animation-play-state: running;
  }
  /* Album art = the record label in the centre. */
  .spotify-vinyl__art {
    position: absolute;
    inset: 11%;
    border-radius: 50%;
    background: #2a2a30 center / cover no-repeat;
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.55);
  }
  /* Centre spindle hole. */
  .spotify-vinyl__disc::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: #050506;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }
  @keyframes spotify-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ── Title + play (discreet, single row) ──────────────────────────────── */
  .spotify-vinyl__title {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--theme-font, 'Inter', sans-serif);
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.25;
    color: #f0eae4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .spotify-vinyl__play {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #1db954;
    color: #06130a;
    cursor: pointer;
    box-shadow: 0 3px 10px -3px rgba(29, 185, 84, 0.6);
    transition: transform 0.15s ease, filter 0.15s ease;
  }
  .spotify-vinyl__play:hover {
    transform: scale(1.08);
    filter: brightness(1.05);
  }
  .spotify-vinyl__play:focus-visible {
    outline: 2px solid #1db954;
    outline-offset: 2px;
  }
  .spotify-vinyl__ico--pause {
    display: none;
  }
  .spotify-vinyl[data-playing='true'] .spotify-vinyl__ico--play {
    display: none;
  }
  .spotify-vinyl[data-playing='true'] .spotify-vinyl__ico--pause {
    display: block;
  }
  .spotify-vinyl__open {
    font-family: 'Space Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, #f0eae4 60%, transparent);
    text-decoration: none;
  }
  .spotify-vinyl__open:hover {
    color: #f0eae4;
  }

  @media (prefers-reduced-motion: reduce) {
    .spotify-vinyl__disc {
      animation: none !important;
    }
    .spotify-vinyl__play {
      transition: none;
    }
  }
</style>

<script>
  import '../../scripts/editor/spotify.ts';
</script>
