---
/**
 * AudioPlayer — splash-gated background audio + volume control (D-06/D-22).
 *
 * Renders NOTHING without a src. The `<audio>` is preload="none", muted and
 * looping; `audio.ts` unmutes + plays only after the `editor:enter` splash
 * gesture (the autoplay-unlock user gesture) and wires a 44px volume/mute toggle
 * plus a volume slider. On an autoplay block the control stays muted with no
 * error text. Same experience on mobile (D-20). The `src` binds only as an
 * <audio src> attribute (auto-escaped); scheme validity is enforced bot-side
 * (plan 09), see T-10.1-04-02.
 */
interface Props {
  src: string;
}
const { src } = Astro.props;
---

{
  src && (
    <div class="editor-audio" data-audio-player data-audio-state="muted">
      <audio data-editor-audio src={src} preload="none" muted loop />

      {/* Vinyl logo — spins while playing (a small "now-playing" cue). */}
      <span class="editor-audio__vinyl" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.6" />
          <circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width="1.6" />
          <circle cx="12" cy="12" r="1" fill="currentColor" />
        </svg>
      </span>

      <button
        type="button"
        class="editor-audio__toggle"
        data-audio-toggle
        aria-pressed="false"
        aria-label="Toggle background audio"
      >
        <svg
          class="editor-audio__icon editor-audio__icon--on"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M11 5 6 9H2v6h4l5 4V5Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          />
          <path
            d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
        <svg
          class="editor-audio__icon editor-audio__icon--off"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M11 5 6 9H2v6h4l5 4V5Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          />
          <path
            d="m16 9 5 6M21 9l-5 6"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </button>

      <input
        type="range"
        class="editor-audio__volume"
        data-audio-volume
        min="0"
        max="1"
        step="0.01"
        value="0.5"
        aria-label="Volume"
      />
    </div>
  )
}

<style>
  /* Fixed top-right widget (was a bottom meta row) — a themed pill that reads as
     a mini player. Sits under the splash (z 1000) so it appears after entering. */
  .editor-audio {
    position: fixed;
    top: var(--space-sm);
    right: var(--space-sm);
    z-index: 900;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: 6px 10px 6px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--theme-bg) 62%, transparent);
    border: 1px solid color-mix(in srgb, var(--theme-text) 14%, transparent);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    backdrop-filter: blur(10px) saturate(1.2);
  }
  @media (max-width: 520px) {
    /* Collapse the slider on small screens so the pill stays tidy in the corner. */
    .editor-audio__volume { display: none; }
  }
  .editor-audio__vinyl {
    display: inline-flex;
    color: var(--theme-accent);
  }
  .editor-audio[data-audio-state='playing'] .editor-audio__vinyl {
    animation: editor-vinyl-spin 3.2s linear infinite;
  }
  @keyframes editor-vinyl-spin {
    to { transform: rotate(360deg); }
  }
  .editor-audio__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--touch-min);
    min-height: var(--touch-min);
    padding: 0;
    color: var(--theme-text);
    background: var(--theme-surface);
    border: 1px solid color-mix(in srgb, var(--theme-text) 14%, transparent);
    border-radius: 50%;
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }
  .editor-audio__toggle:hover,
  .editor-audio[data-audio-state='playing'] .editor-audio__toggle {
    color: var(--theme-accent);
    border-color: var(--theme-accent);
  }
  .editor-audio__toggle:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 2px;
  }

  /* Show the glyph matching the current playback state. */
  .editor-audio__icon--on {
    display: none;
  }
  .editor-audio__icon--off {
    display: block;
  }
  .editor-audio[data-audio-state='playing'] .editor-audio__icon--on {
    display: block;
  }
  .editor-audio[data-audio-state='playing'] .editor-audio__icon--off {
    display: none;
  }

  .editor-audio__volume {
    width: 80px;
    min-height: var(--touch-min);
    accent-color: var(--theme-accent);
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .editor-audio__toggle {
      transition: none;
    }
    .editor-audio[data-audio-state='playing'] .editor-audio__vinyl {
      animation: none;
    }
  }
</style>

<script>
  import '../../scripts/editor/audio.ts';
</script>
