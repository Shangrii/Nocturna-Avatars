---
/**
 * PresenceDot — live Discord status dot via the public Lanyard API (D-05).
 *
 * Hidden by default; `presence.ts` reveals it ONLY on a successful fetch and
 * leaves it hidden on any failure (unreachable / non-member / no status) with no
 * error text (Copywriting Contract). The dot colour is a fixed semantic status
 * colour (online/idle/dnd/offline); the surrounding ring uses --theme-accent.
 * Renders nothing without a discordId.
 */
interface Props {
  discordId: string;
}
const { discordId } = Astro.props;
---

{
  discordId && (
    <span class="editor-presence" data-presence data-discord-id={discordId} hidden>
      <span class="editor-presence__dot" data-presence-dot aria-hidden="true" />
    </span>
  )
}

<style>
  /* Discord-style corner status: a small colored dot punched into the avatar's
     bottom-right, anchored to `.editor-header-card__avatar-wrap` (position:relative).
     No side chip / no activity text — just the status colour, like Discord. */
  .editor-presence {
    position: absolute;
    right: 7%;
    bottom: 7%;
    z-index: 3;
    display: block;
    line-height: 0;
  }
  /* The `hidden` attribute must win: presence.ts only reveals the dot on a
     successful Lanyard read. Author `display` overrides the UA `[hidden]` rule,
     so restore it explicitly — otherwise a fake default-green dot always shows
     even when the user isn't monitored (or is actually idle/dnd/offline). */
  .editor-presence[hidden] {
    display: none;
  }
  .editor-presence__dot {
    display: block;
    width: clamp(18px, 5vw, 26px);
    height: clamp(18px, 5vw, 26px);
    border-radius: 50%;
    background: var(--presence-color, #3ba55d);
    /* Cut-out ring in the page colour (like Discord's avatar notch) + soft glow. */
    border: 0.22em solid var(--theme-bg, #0a0c14);
    box-shadow: 0 0 10px 1px color-mix(in srgb, var(--presence-color, #3ba55d) 65%, transparent);
    animation: editor-presence-pulse 2.4s ease-in-out infinite;
  }
  @keyframes editor-presence-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.6;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .editor-presence__dot {
      animation: none;
    }
  }
</style>

<script>
  import '../../scripts/editor/presence.ts';
</script>
