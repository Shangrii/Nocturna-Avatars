---
/**
 * LightboxOverlay — the shared hidden lightbox overlay partial (Plan 04-03).
 *
 * Extracted VERBATIM from the inline overlay Plan 02 authored in GalleryPage.astro
 * so a single canonical overlay markup is rendered on BOTH the full pin-wall
 * (/galeria · /gallery) and the landing featured grid. gallery.ts binds against
 * exactly one `[data-lightbox-overlay]` per page and derives its entries from the
 * rendered `[data-gallery-tile]` nodes, so this partial needs zero new JS.
 *
 * Reuses the CartSummaryModal `.dc-overlay` attribute set (incl. data-lenis-prevent
 * which pauses Lenis while open). The img / caption / counter are populated by
 * gallery.ts via textContent ONLY (never innerHTML) — captions originate from
 * Discord (untrusted), so a malicious caption stays inert text (T-04-07).
 */
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const lightbox = useTranslations(lang, 'pages').lightbox;
---

<div
  class="dc-overlay lightbox"
  data-lightbox-overlay
  hidden
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label={lightbox.dialogLabel}
  data-counter-label={lightbox.counterLabel}
  data-lenis-prevent
>
  <button
    type="button"
    class="lightbox__ctrl lightbox__close"
    data-lightbox-close
    aria-label={lightbox.close}
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  </button>

  <button
    type="button"
    class="lightbox__ctrl lightbox__prev"
    data-lightbox-prev
    aria-label={lightbox.prev}
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <figure class="lightbox__stage" data-lightbox-stage>
    <img class="lightbox__img" data-lightbox-img alt="" />
    <figcaption class="lightbox__meta">
      <span class="lightbox__counter" data-lightbox-counter aria-live="polite"></span>
      <span class="lightbox__caption" data-lightbox-caption hidden></span>
    </figcaption>
  </figure>

  <button
    type="button"
    class="lightbox__ctrl lightbox__next"
    data-lightbox-next
    aria-label={lightbox.next}
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</div>
