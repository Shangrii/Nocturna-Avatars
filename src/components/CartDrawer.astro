---
interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;
---

<!-- Backdrop -->
<div class="cart-backdrop" id="cartBackdrop" aria-hidden="true" hidden></div>

<!-- Drawer -->
<aside
  class="cart-drawer"
  id="cartDrawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cartDrawerTitle"
  hidden
>
  <!-- Header -->
  <div class="cart-drawer__header">
    <span class="cart-drawer__title" id="cartDrawerTitle">
      {lang === 'es' ? 'Tu selección' : 'Your selection'}
    </span>
    <button
      class="cart-drawer__close"
      type="button"
      data-cart-close
      aria-label={lang === 'es' ? 'Cerrar panel' : 'Close panel'}
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          d="M5 5L15 15M15 5L5 15"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>
    </button>
  </div>

  <!-- Item list — populated by cart.ts syncCartUI() -->
  <ul
    class="cart-drawer__items"
    aria-label={lang === 'es' ? 'Servicios seleccionados' : 'Selected services'}
  >
    <!-- Populated by cart.ts syncCartUI() — do not add static items -->
  </ul>

  <!-- Footer: total + CTA -->
  <div class="cart-drawer__footer">
    <div class="cart-drawer__total">
      <span class="cart-drawer__total-label">
        {lang === 'es' ? 'Total estimado' : 'Estimated total'}
      </span>
      <span class="cart-drawer__total-value">
        $<span data-cart-total>0</span> USD
      </span>
    </div>
    <button class="cart-drawer__cta" type="button" data-cart-ticket>
      {lang === 'es' ? 'Abrir Ticket' : 'Open Ticket'}
    </button>
  </div>
</aside>

<style>
  /* ── Backdrop ── */
  .cart-backdrop {
    position: fixed;
    inset: 0;
    z-index: 950;
    background: rgba(4, 5, 10, 0.82);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .cart-backdrop.active {
    opacity: 1;
    pointer-events: all;
  }

  .cart-backdrop[hidden] {
    display: none;
  }

  /* ── Drawer panel ── */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 960;
    width: min(420px, 92vw);
    background: var(--color-ink-raised); /* #10131e */
    border-left: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }

  .cart-drawer.active {
    transform: translateX(0);
  }

  .cart-drawer[hidden] {
    display: none;
  }

  /* ── Header ── */
  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-sm);
    background: var(--color-ink); /* #0a0c14 */
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .cart-drawer__title {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-white-dim);
  }

  .cart-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    min-height: 32px;
    background: transparent;
    border: none;
    color: var(--color-white-dim);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .cart-drawer__close:hover,
  .cart-drawer__close:focus-visible {
    color: var(--color-white);
  }

  .cart-drawer__close:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  /* ── Item list ── */
  .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Item rows — generated by cart.ts */
  .cart-drawer__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding: var(--space-sm) var(--space-sm);
    border-bottom: 1px solid var(--color-border);
    transition: background 0.2s ease;
  }

  .cart-drawer__item:hover {
    background: color-mix(in srgb, var(--color-paper-on-ink) 4%, transparent);
  }

  .cart-drawer__item-name {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    color: var(--color-paper-on-ink);
    flex: 1;
  }

  .cart-drawer__item-qty {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-white-dim);
    flex-shrink: 0;
  }

  .cart-drawer__item-price {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--color-paper-on-ink);
    flex-shrink: 0;
  }

  .cart-drawer__item-remove {
    background: transparent;
    border: none;
    color: var(--color-white-dim);
    font-size: 16px;
    cursor: pointer;
    min-width: 32px;
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .cart-drawer__item-remove:hover {
    color: var(--color-red-on-paper);
  }

  .cart-drawer__item-remove:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  /* ── Footer ── */
  .cart-drawer__footer {
    flex-shrink: 0;
    padding: var(--space-lg) var(--space-sm);
    background: var(--color-ink);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .cart-drawer__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .cart-drawer__total-label {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-white-dim);
  }

  .cart-drawer__total-value {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-white);
  }

  /* ── Drawer CTA ── */
  .cart-drawer__cta {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: var(--space-sm);
    background: var(--color-red);
    color: var(--color-white);
    border: none;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .cart-drawer__cta:hover {
    background: var(--color-red-dark);
    transform: translateY(-1px);
  }

  .cart-drawer__cta:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }
</style>
