---
/**
 * TextBlock — a single-language paragraph (Body role, Inter 16px/1.7).
 *
 * Identical safety contract to BioBlock: plain-string text via `blockText` (D-13
 * single-language, legacy `{es,en}`-tolerant) rendered through Astro auto-escaping
 * ONLY (never a raw-HTML directive, D-02). Empty text renders nothing.
 */
import type { BlockOf } from '../../lib/editorTypes';
import type { Lang } from '../../i18n/ui';
import { blockText } from '../../lib/editorText';

interface Props {
  block: BlockOf<'text'>;
  lang: Lang;
}

const { block, lang } = Astro.props;
const text = blockText(block.text, lang);
---

{text && <p class="editor-text">{text}</p>}

<style>
  .editor-text {
    margin: 0;
    font-family: var(--theme-font);
    font-size: var(--type-body);
    font-weight: 400;
    line-height: var(--lh-body);
    color: var(--theme-text);
  }
</style>
