---
/**
 * QuoteBlock — a single-language pull-quote (Space Grotesk 700) with a red rule accent
 * (UI-SPEC reserved-red list) and an optional attribution line.
 *
 * Plain-string quote text via `blockText` (D-13 single-language, legacy
 * `{es,en}`-tolerant) and the single-string attribution both render through Astro
 * auto-escaping ONLY (never a raw-HTML directive, D-02). Empty quote text renders
 * nothing; the attribution renders only when present.
 */
import type { BlockOf } from '../../lib/editorTypes';
import type { Lang } from '../../i18n/ui';
import { blockText } from '../../lib/editorText';

interface Props {
  block: BlockOf<'quote'>;
  lang: Lang;
}

const { block, lang } = Astro.props;
const text = blockText(block.text, lang);
const attribution = typeof block.attribution === 'string' ? block.attribution : '';
---

{text && (
  <figure class="editor-quote">
    <blockquote class="editor-quote__text">{text}</blockquote>
    {attribution && <figcaption class="editor-quote__by">{attribution}</figcaption>}
  </figure>
)}

<style>
  .editor-quote {
    margin: 0;
    padding-left: var(--space-sm);
    border-left: 3px solid var(--theme-accent);
  }
  .editor-quote__text {
    margin: 0;
    font-family: var(--theme-font);
    font-size: var(--type-card-title);
    font-weight: 700;
    line-height: var(--lh-heading);
    color: var(--theme-text);
  }
  .editor-quote__by {
    margin-top: var(--space-2xs);
    font-family: var(--theme-font);
    font-size: var(--type-label);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--theme-text-muted);
  }
</style>
