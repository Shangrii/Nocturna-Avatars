---
/**
 * BioBlock — a single-language bio paragraph (Body role, Inter 16px/1.7).
 *
 * Resolves `block.text` to a plain string via `blockText` (D-13 single-language,
 * legacy `{es,en}`-tolerant), rendered through Astro auto-escaping ONLY (never a
 * raw-HTML directive, D-02). Renders nothing when the text is empty so an unfilled
 * block leaves no empty tag.
 */
import type { BlockOf } from '../../lib/editorTypes';
import type { Lang } from '../../i18n/ui';
import { blockText } from '../../lib/editorText';

interface Props {
  block: BlockOf<'bio'>;
  lang: Lang;
}

const { block, lang } = Astro.props;
const text = blockText(block.text, lang);
---

{text && <p class="editor-bio">{text}</p>}

<style>
  .editor-bio {
    margin: 0;
    font-family: var(--theme-font);
    font-size: var(--type-body);
    font-weight: 400;
    line-height: var(--lh-body);
    color: var(--theme-text);
  }
</style>
