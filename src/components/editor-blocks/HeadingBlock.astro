---
/**
 * HeadingBlock — a single-language section heading (Heading role, Space Grotesk 700).
 *
 * Plain-string text via `blockText` (D-13 single-language, legacy `{es,en}`-tolerant)
 * rendered through Astro auto-escaping ONLY (never a raw-HTML directive, D-02). Empty
 * text renders nothing.
 */
import type { BlockOf } from '../../lib/editorTypes';
import type { Lang } from '../../i18n/ui';
import { blockText } from '../../lib/editorText';

interface Props {
  block: BlockOf<'heading'>;
  lang: Lang;
}

const { block, lang } = Astro.props;
const text = blockText(block.text, lang);
---

{text && <h2 class="editor-heading">{text}</h2>}

<style>
  .editor-heading {
    margin: 0;
    font-family: var(--theme-font);
    font-size: var(--type-heading);
    font-weight: 700;
    line-height: var(--lh-heading);
    color: var(--theme-text);
  }
</style>
