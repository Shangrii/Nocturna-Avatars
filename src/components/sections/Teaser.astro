---
/**
 * Teaser — placeholder featured-work / gallery teaser on the landing (NAV-01).
 *
 * In Phase 1 these are PLACEHOLDERS (the real featured subset + masonry gallery
 * are Phase 4). Each renders the branded coming-soon EmptyState with a
 * "Ver galería" / "View gallery" link to /<lang>/galeria so the section never
 * looks broken and the conversion path stays reachable (NAV-03).
 */
import EmptyState from '../EmptyState.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routes';

interface Props {
  lang: Lang;
  variant: 'featured' | 'gallery';
}
const { lang, variant } = Astro.props;
const p = useTranslations(lang, 'pages');
const head = variant === 'featured' ? p.teaser.featured : p.teaser.gallery;
const e = p.emptyState;
---

<section class={`section${variant === 'gallery' ? ' section--surface' : ''} section--rule`}>
  <div class="section-header reveal">
    <span class="section-tag">{head.tag}</span>
    <h2 class="section-title">{head.title}</h2>
  </div>
  <div class="reveal">
    <EmptyState
      heading={e.heading}
      body={e.galleryBody}
      ticketLabel={e.ticketCta}
      linkLabel={e.galleryCta}
      linkHref={localizedPath('gallery', lang)}
    />
  </div>
</section>
