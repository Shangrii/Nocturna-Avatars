---
/**
 * TermsPage — body of the /es/terminos · /en/terms page (I18N-04).
 *
 * Renders the full Terms & Conditions for the active locale from terms.json:
 *   - a page header (tag/title/subtitle),
 *   - a short 4-item summary,
 *   - all 10 numbered Terms blocks (ES verbatim from the old site; EN a faithful
 *     Claude-written draft),
 *   - on EN only, a prominent ReviewerBanner flagging the draft (D-13).
 *
 * Long-form legal copy uses the --lh-legal (1.8) line height via terms.css.
 * All copy renders through Astro auto-escaping (no set:html) — T-01-13. Bold
 * clauses are static template markup driven by a per-segment `strong` flag, not
 * raw HTML from data.
 *
 * Mounted by the [lang]/[page].astro resolver, so it inherits the global chrome
 * (nav / footer / floating CTA / Discord modal) from BaseLayout.
 */
import ReviewerBanner from '../ReviewerBanner.astro';
import NightBackground from '../NightBackground.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang, 'terms');
// Banner copy lives on the EN slice only.
const banner = lang === 'en' ? (t as typeof t & { bannerTitle: string; bannerBody: string }) : null;
---

{/* Reusable night-sky backdrop (0q0) — full-viewport fixed field behind the page.
    The reading column's section is made transparent (scoped style below) so the
    night shows through; the summary/block copy is already off-white on this dark
    reskin, so AA holds over the night. */}
<NightBackground fixed />

<section class="section section--surface section-page-top section--rule">
  <div class="section-header reveal">
    <span class="section-tag">{t.tag}</span>
    <h2 class="section-title">{t.title}</h2>
    <p class="section-subtitle">{t.subtitle}</p>
  </div>

  <div class="terms-wrap night-panel">
    {lang === 'en' && banner && (
      <ReviewerBanner title={banner.bannerTitle} body={banner.bannerBody} />
    )}

    <div class="terms-summary reveal">
      <h3 class="terms-summary-title">{t.summaryTitle}</h3>
      <ul class="terms-summary-list">
        {t.summary.map((item) => (
          <li><strong>{item.lead}</strong>{item.rest}</li>
        ))}
      </ul>
    </div>

    <div class="terms-blocks">
      {t.blocks.map((block) => (
        <article class="terms-block reveal">
          <h3 class="terms-block-title">
            <span class="terms-block-num">{block.num}</span>
            <span>{block.title}</span>
          </h3>
          <p class="terms-block-body">
            {block.body.map((seg) =>
              seg.strong ? <strong>{seg.text}</strong> : <Fragment>{seg.text}</Fragment>,
            )}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* Night backdrop reveal (0q0) — drop the opaque paper section field on the Terms
     page so the fixed <NightBackground /> shows through. The reskin's paper surface
     is already dark navy (#11141f) with off-white text (#f0eae4), so the night is the
     same dark family and the reading column stays AA. The summary box + reviewer
     banner keep their own subtle fills for legibility. */
  main .section--surface {
    background: transparent;
  }

  /* Interior page (no hero): hold the nav in its solid dark state so the transparent
     top-of-page nav never shows the night field through it. Mirrors ServicesPage. */
  .nav {
    background: rgba(10, 12, 20, 0.95);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--color-border);
  }
</style>
