---
/**
 * ServicesPage — body of the /servicios (es) · /services (en) page.
 *
 * The REAL 3-package section (faithful data, D-12) via PackageCard + the
 * add-ons block, followed by a "coming soon" shell for the full modular catalog
 * (the data-driven services.json catalog is Phase 3). Copy from pages.json.
 * Extracted into a component so the localized [page].astro resolver stays thin.
 */
import PackageCard from '../PackageCard.astro';
import CatalogSection from '../CatalogSection.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import servicesData from '../../data/services.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = useTranslations(lang, 'pages').servicios;

const catalogEmptyHeading = lang === 'es' ? 'Próximamente' : 'Coming Soon';
const catalogEmptyBody = lang === 'es'
  ? 'Estamos definiendo los precios. Abre un ticket y te damos info de primera mano.'
  : "We're finalizing pricing. Open a ticket and we'll give you the details directly.";
const catalogEmptyTicketLabel = lang === 'es' ? 'Abrir Ticket' : 'Open Ticket';

const resolvedTiers = servicesData.packages.tiers.map((tier) => ({
  ...tier,
  tier: (tier.tier as { es: string; en: string })[lang],
  subtitle: (tier.subtitle as { es: string; en: string })[lang],
  oneLiner: (tier.oneLiner as { es: string; en: string })[lang],
  features: tier.features.map((f) => ({
    text: (f.text as { es: string; en: string })[lang],
    highlight: f.highlight,
  })),
}));

const resolvedAddons = servicesData.packages.addons.map((a) => ({
  name: (a.name as { es: string; en: string })[lang],
  price: a.price,
}));

const addonsNote = (servicesData.packages.addonsNote as { es: string; en: string })[lang];
---

<section class="section section-page-top section--rule">
  <div class="section-header reveal">
    <span class="section-tag">{page.tag}</span>
    <h2 class="section-title">{page.title}</h2>
    <p class="section-subtitle">{page.subtitle}</p>
  </div>

  <div class="cards">
    {resolvedTiers.map((tier) => (
      <PackageCard
        tier={tier}
        usd={page.usd}
        advanceNote={page.advanceNote}
        popularBadge={page.popularBadge}
        ctaLabel={page.ctaTicket}
      />
    ))}
  </div>

  <div class="addons reveal">
    <h3 class="addons-title">{page.addonsTitle}</h3>
    <div class="addon-grid">
      {resolvedAddons.map((addon) => (
        <div class="addon-item">
          <div class="name">{addon.name}</div>
          <div class="price">{addon.price}</div>
        </div>
      ))}
    </div>
    <p class="addons-note">{addonsNote}</p>
  </div>
</section>

<section class="section section--surface section--rule">
  <div class="section-header reveal">
    <span class="section-tag">{page.catalogTag}</span>
    <h2 class="section-title">{page.catalogTitle}</h2>
  </div>
  <CatalogSection
    catalog={servicesData.catalog}
    lang={lang}
    emptyHeading={catalogEmptyHeading}
    emptyBody={catalogEmptyBody}
    emptyTicketLabel={catalogEmptyTicketLabel}
  />
</section>
