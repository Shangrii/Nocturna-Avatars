---
/**
 * ServicesPage — body of the /servicios (es) · /services (en) page.
 *
 * The REAL 3-package section (faithful data, D-12) via PackageCard + the
 * add-ons block, followed by a "coming soon" shell for the full modular catalog
 * (the data-driven services.json catalog is Phase 3). Copy from pages.json.
 * Extracted into a component so the localized [page].astro resolver stays thin.
 */
import PackageCard from '../PackageCard.astro';
import CatalogSection from '../CatalogSection.astro';
import NightBackground from '../NightBackground.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import servicesData from '../../data/services.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = useTranslations(lang, 'pages').servicios;

const catalogEmptyHeading = lang === 'es' ? 'Próximamente' : 'Coming Soon';
const catalogEmptyBody = lang === 'es'
  ? 'Estamos definiendo los precios. Abre un ticket y te damos info de primera mano.'
  : "We're finalizing pricing. Open a ticket and we'll give you the details directly.";
const catalogEmptyTicketLabel = lang === 'es' ? 'Abrir Ticket' : 'Open Ticket';

const resolvedTiers = servicesData.packages.tiers.map((tier) => ({
  ...tier,
  tier: (tier.tier as { es: string; en: string })[lang],
  subtitle: (tier.subtitle as { es: string; en: string })[lang],
  oneLiner: (tier.oneLiner as { es: string; en: string })[lang],
  features: tier.features.map((f) => ({
    text: (f.text as { es: string; en: string })[lang],
    highlight: f.highlight,
  })),
}));

---

{/* Reusable night-sky backdrop (0q0) — full-viewport fixed field behind the page.
    The on-page sections are made transparent (scoped style block below) so the
    night shows through; card/catalog surfaces keep their own dark fills so copy
    stays readable (all page text is already off-white on this dark reskin). */}
<NightBackground fixed />

<section class="section section-page-top section--rule">
  <div class="section-header reveal">
    <span class="section-tag">{page.tag}</span>
    <h2 class="section-title">{page.title}</h2>
    <p class="section-subtitle">{page.subtitle}</p>
  </div>

  <div class="cards">
    {resolvedTiers.map((tier) => (
      <PackageCard
        tier={tier}
        usd={page.usd}
        advanceNote={page.advanceNote}
        popularBadge={page.popularBadge}
        ctaLabel={page.ctaTicket}
        quoteTicket={true}
      />
    ))}
  </div>

</section>

<section class="section section--surface section--rule">
  <div class="section-header reveal">
    <span class="section-tag">{page.catalogTag}</span>
    <h2 class="section-title">{page.catalogTitle}</h2>
  </div>
  {/* Readability panel (1yi) — solid ink-raised surface matching the Level 1/2/3
      cards so the catalog rows + contact note read cleanly over the night field.
      Section header stays outside the panel (display type reads fine over night). */}
  <div class="night-panel night-panel--catalog reveal">
    <CatalogSection
      catalog={servicesData.catalog}
      lang={lang}
      emptyHeading={catalogEmptyHeading}
      emptyBody={catalogEmptyBody}
      emptyTicketLabel={catalogEmptyTicketLabel}
      enableCart={true}
    />

    <p class="catalog-contact-note">
      {lang === 'es'
        ? '¿Necesitas una modificación que no aparece en las opciones? '
        : 'Need a modification that isn’t listed in the options? '}
      <button type="button" class="catalog-contact-note__link dc-trigger">
        {lang === 'es' ? 'Contáctanos' : 'Contact us'}
      </button>
    </p>
  </div>
</section>

<!--
  The cart/quote overlays (CartDrawer, CartPill, CartSummaryModal) are rendered by
  [page].astro into BaseLayout's body-level chrome-bottom slot so they escape the
  <main> view-transition stacking context. This page only loads the engine + tweaks
  the FloatingCTA position below.

  The cart circle (#cartPill) occupies the bottom-right corner on this page, so
  shift the global FloatingCTA left to sit beside it. This <style is:global> ships
  only on pages that render ServicesPage (the services route), so it does not move
  the FloatingCTA anywhere else.
-->
<style is:global>
  .floating-cta {
    right: calc(clamp(16px, 4vw, 32px) + 52px + 12px);
  }

  /* Interior page (no hero): keep the nav in its solid dark state at all times so it
     reads dark like the landing, instead of the transparent top-of-page nav showing
     the page behind it. CSS-level guarantee (independent of the JS scroll handler). */
  .nav {
    background: rgba(10, 12, 20, 0.95);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--color-border);
  }

  /* Night backdrop reveal (0q0) — drop the opaque ink/paper section fields on this
     page so the fixed <NightBackground /> shows through. Both surfaces are already
     dark navy with off-white text on this reskin (--color-ink #0a0c14, --color-paper
     #11141f, text #f0eae4), so the night is the same dark family and AA is preserved.
     Card/catalog/nav surfaces keep their own fills (below), so copy stays readable. */
  main .section,
  main .section--surface {
    background: transparent;
  }
</style>

<style>
  /* Catalog readability panel (1yi): sized so the inner .catalog-cat column
     (max-width 1000px, from CatalogSection.astro) keeps its measure once the
     panel's own horizontal padding is added. Centered under the section header. */
  .night-panel--catalog {
    max-width: calc(1000px + var(--space-lg) * 2);
    margin-inline: auto;
  }
  .catalog-contact-note {
    /* Now inside .night-panel — drop the panel-duplicating page-gutter padding and
       auto max-width; keep the top margin so it separates from the catalog rows. */
    margin: var(--space-xl) 0 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-white-dim);
  }
  .catalog-contact-note__link {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--color-red-on-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .catalog-contact-note__link:hover {
    color: var(--color-red-glow);
  }
  .catalog-contact-note__link:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }
</style>

<script>
  import '../../scripts/cart.ts';
</script>
