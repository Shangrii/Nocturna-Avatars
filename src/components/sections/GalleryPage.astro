---
/**
 * GalleryPage — body of the /galeria (es) · /gallery (en) page.
 *
 * Data-driven pin-wall read from src/data/gallery.json (Phase 5 bot write
 * target). Entries render newest-first by `date` (D-05) as a wall of squared,
 * CLS-free aspect-ratio tiles (D-04) — each a focusable <button> the Plan 02
 * lightbox opens at its index. When gallery.json is empty the page keeps the
 * branded EmptyState so it never looks broken and the Discord CTA stays
 * reachable (D-12).
 *
 * The scatter layout + the lightbox are wired in Plan 02 (src/scripts/gallery.ts);
 * this ships the static markup + data hooks + CSS the wall needs. Without JS the
 * tiles still render as a valid flowed grid so the build and content verify now.
 *
 * All caption/alt text is rendered through Astro auto-escaping — raw HTML
 * injection is never used. Captions originate from Discord (untrusted) but are
 * only ever an `alt` attribute here, so a malicious caption cannot execute
 * (T-04-01).
 */
import EmptyState from '../EmptyState.astro';
import LightboxOverlay from '../LightboxOverlay.astro';
import NightBackground from '../NightBackground.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import galleryData from '../../data/gallery.json';
import '../../styles/gallery.css';

interface GalleryEntry {
  file: string;
  caption?: string;
  width: number;
  height: number;
  date: string;
}

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = useTranslations(lang, 'pages').galeria;
const empty = useTranslations(lang, 'pages').emptyState;
const altFallback = useTranslations(lang, 'pages').gallery.altFallback;
const newBadge = useTranslations(lang, 'pages').gallery.newBadge;

// Newest-first by `date` (D-05). Copy before sorting so the imported module
// array is never mutated.
const entries = ([...(galleryData as GalleryEntry[])]).sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

// Desktop column count (UI-SPEC Layout Contract) — the first row loads eagerly
// to fill the fold fast; everything after defers via native lazy-loading (D-09).
const EAGER_COUNT = 4;

// Deterministic FNV-1a hash — drives every "random-looking" per-photo choice so
// the wall is identical on every build (no reshuffle) yet looks unpatterned.
// Sizes and positions are now computed by the scatter engine in gallery.ts;
// only the hang angle stays here (it's static markup, works without JS too).
function hashStr(s: string): number {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 0x01000193);
  }
  return h >>> 0;
}

// Pin-wall tilt — each polaroid hangs at a small, stable angle (−4°..+4°).
function tiltFor(entry: GalleryEntry): number {
  return ((hashStr(entry.file) >>> 8) % 9) - 4; // unsigned shift → stable −4°..+4°
}

// Fastening mix — most photos get a push-pin, ~38% get translucent tape corners
// instead, so the wall reads like a real hand-built collage. Deterministic.
// (The red thread only connects PINNED photos — gallery.ts queries .pin — which
// keeps the thread organic rather than exhaustive.)
function holdFor(entry: GalleryEntry): 'pin' | 'tape' {
  return (hashStr(entry.file) >>> 5) % 100 < 38 ? 'tape' : 'pin';
}
---

<section class="section section-page-top section--rule gallery-night">
  {/* Night sky + drifting fireflies — the shared <NightBackground /> backdrop
      (extracted from this page in the 0q0 quick task). Fills the positioned
      .gallery-night section; gallery.ts drives its --sky-shift parallax via the
      inherited custom prop on the section. Carries stars, washes, the nav blend
      and the fireflies. */}
  <NightBackground />

  <div class="section-header reveal">
    <span class="section-tag">{page.tag}</span>
    <h2 class="section-title">{page.title}</h2>
    <p class="section-subtitle">{page.subtitle}</p>
  </div>

  {entries.length ? (
    <div class="gallery-wall" data-gallery-wall>
      {/* Signature decor layer — gallery.ts draws the red thread (pin-to-pin,
          sagging curves), the fairy-light garland (draped along the top) and the
          sparse warm board lamps into this SVG after the scatter layout settles,
          and redraws on every relayout. It sits behind the polaroids so pins
          appear to hold the thread. Empty until JS. */}
      <svg class="gallery-thread" data-gallery-thread aria-hidden="true" preserveAspectRatio="none"></svg>

      {/* Torch — a warm light halo that follows the cursor across the board
          (desktop pointer only; gallery.ts drives --tx/--ty; off under
          prefers-reduced-motion). Sits above the cards like light falling on them. */}
      <span class="gallery-torch" data-gallery-torch aria-hidden="true"></span>

      {entries.map((entry, i) => {
        return (
        <button
          type="button"
          class="gallery-tile"
          data-gallery-tile
          data-index={i}
          data-file={entry.file}
          data-caption={entry.caption ?? ''}
          style={`--tilt:${tiltFor(entry)}deg`}
        >
          <span class="polaroid">
            {holdFor(entry) === 'pin' ? (
              <span class="pin" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path class="pin__needle" d="M11.5 13 L12.3 22 L13 13 Z" />
                  <circle class="pin__head" cx="12" cy="8" r="6.4" />
                  <circle class="pin__shine" cx="9.7" cy="5.9" r="1.9" />
                </svg>
              </span>
            ) : (
              <>
                <span class="tape tape--l" aria-hidden="true"></span>
                <span class="tape tape--r" aria-hidden="true"></span>
              </>
            )}
            {i === 0 && <span class="scribble-new" aria-hidden="true">{newBadge}</span>}
            <span class="polaroid__photo" style={`aspect-ratio:${entry.width}/${entry.height}`}>
              <img
                src={`/gallery/${entry.file}`}
                width={entry.width}
                height={entry.height}
                alt={entry.caption ?? altFallback}
                loading={i < EAGER_COUNT ? 'eager' : 'lazy'}
                decoding="async"
              />
            </span>
            {entry.caption && <span class="polaroid__cap">{entry.caption}</span>}
          </span>
        </button>
        );
      })}
    </div>
  ) : (
    <div class="reveal">
      <EmptyState
        heading={empty.heading}
        body={empty.galleryBody}
        ticketLabel={empty.ticketCta}
      />
    </div>
  )}
</section>

{/*
  Hand-rolled lightbox overlay (D-13). Now authored ONCE in the shared
  LightboxOverlay.astro partial (Plan 04-03) and reused verbatim by both /galeria
  and the landing featured grid, so gallery.ts binds one canonical
  [data-lightbox-overlay] per page. Rendered only when the wall has entries.
*/}
{entries.length ? <LightboxOverlay lang={lang} /> : null}

<!-- Pin-wall scatter init + hand-rolled lightbox controller (swap-safe, Plan 02). -->
<script>
  import '../../scripts/gallery.ts';
</script>
