---
/**
 * EditorsDirectory — body of the /editores (es) · /en/editors (en) directory
 * (D-20). Lists every PUBLISHED editor as an avatar + name + tagline card that
 * links to the per-editor profile, so the individual pages (10-07 Task 1) are
 * discoverable rather than orphaned.
 *
 * Data-driven from src/data/editors.json (the admin app / bot commit target —
 * externally written, D-18). The read is defensive end-to-end (mirrors
 * StorePage): a copy-before-filter keeps only `published` entries with a usable
 * string slug, then sorts by name — one malformed entry must never throw the
 * whole-site build (T-10-07-02). An empty directory falls back to the branded
 * EmptyState so it never looks broken and the "Abrir Ticket" Discord CTA stays
 * reachable (NAV-03).
 *
 * All copy renders through Astro `{...}` auto-escaping — no raw-HTML directive is
 * ever used on editors.json fields (T-10-07-01, D-02).
 */
import EmptyState from '../EmptyState.astro';
import NightBackground from '../NightBackground.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { editorPath } from '../../i18n/routes';
import editorsData from '../../data/editors.json';

/**
 * Every field except `slug` is treated as OPTIONAL because editors.json is
 * written by the admin app / bot — the schema documents intent but the build
 * must tolerate a missing/typo'd key. Never assume a field is present.
 */
interface EditorEntry {
  slug: string;
  published?: boolean;
  name?: string;
  avatar?: string;
  tagline?: { es?: string; en?: string };
}

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = useTranslations(lang, 'pages').editores;

// Copy before sorting so the imported module array is never mutated. Keep only
// published entries with a usable string slug; sort A→Z by resolved name.
const rawEditors: EditorEntry[] = Array.isArray(editorsData)
  ? ([...editorsData] as EditorEntry[])
  : [];
const editors = rawEditors
  .filter(
    (e) =>
      Boolean(e) &&
      e.published === true &&
      typeof e.slug === 'string' &&
      e.slug.length > 0,
  )
  .map((e) => ({
    slug: e.slug,
    name: typeof e.name === 'string' && e.name ? e.name : e.slug,
    avatar: typeof e.avatar === 'string' ? e.avatar : '',
    tagline: e.tagline?.[lang] ?? e.tagline?.es ?? e.tagline?.en ?? '',
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

{/* D-16: the directory is unlisted (no navbar entry, landed in plan 01) but stays
    crawlable via inbound links. The noindex,follow robots directive is emitted into
    <head> by BaseLayout (threaded from the [lang]/[page].astro resolver for the
    `editors` concept) — a robots meta placed here in the component body would render
    inside <body>, where crawlers ignore it. The individual /e/<slug> pages stay
    index,follow. */}

{/* Reusable night-sky backdrop — full-viewport fixed field behind the directory. */}
<NightBackground fixed />

<section class="section section-page-top section--rule">
  <div class="section-header reveal">
    <span class="section-tag">{page.tag}</span>
    <h2 class="section-title">{page.title}</h2>
    <p class="section-subtitle">{page.subtitle}</p>
  </div>

  {editors.length ? (
    <div class="editors-grid">
      {editors.map((editor) => (
        <a class="editor-card reveal" href={editorPath(editor.slug, lang)}>
          <span class="editor-card__avatar-wrap">
            {editor.avatar ? (
              <img
                class="editor-card__avatar"
                src={editor.avatar}
                alt={editor.name}
                width="120"
                height="120"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="editor-card__avatar editor-card__avatar--fallback" aria-hidden="true">
                {editor.name.slice(0, 1).toUpperCase()}
              </span>
            )}
          </span>
          <span class="editor-card__name">{editor.name}</span>
          {editor.tagline && <span class="editor-card__tagline">{editor.tagline}</span>}
          <span class="editor-card__cta" aria-hidden="true">{page.cardCta ?? '→'}</span>
        </a>
      ))}
    </div>
  ) : (
    <div class="reveal">
      <EmptyState
        heading={page.emptyHeading}
        body={page.emptyBody}
        ticketLabel={page.emptyCta}
      />
    </div>
  )}
</section>

<style is:global>
  /* Interior page (no hero): keep the nav in its solid dark state at all times. */
  .nav {
    background: rgba(10, 12, 20, 0.95);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--color-border);
  }

  /* Drop the opaque section field so the fixed <NightBackground /> shows through. */
  main .section {
    background: transparent;
  }
</style>

<style>
  /* Responsive card grid: 1 col mobile → 2 col tablet → 3 col desktop, lg gap. */
  .editors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    max-width: 1000px;
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .editors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .editors-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Glass card teaser (10.1 D-16): translucent glassmorphism surface over the ink
     night field, an avatar tile with a soft red glow, and a hover lift — a taste of
     the premium per-editor page look while staying on Nocturna brand tokens. */
  .editor-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2xs);
    padding: var(--space-lg);
    background: rgba(240, 234, 228, 0.06);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    text-decoration: none;
    overflow: hidden;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgba(240, 234, 228, 0.08) inset,
      0 18px 40px -24px rgba(0, 0, 0, 0.7);
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  /* Faint red top-edge sheen — the reserved brand accent, subtle at rest. */
  .editor-card::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--color-red) 65%, transparent),
      transparent
    );
    opacity: 0.35;
    transition: opacity 0.25s ease;
  }
  .editor-card:hover {
    border-color: color-mix(in srgb, var(--color-red) 55%, transparent);
    transform: translateY(-4px);
    box-shadow: 0 1px 0 rgba(240, 234, 228, 0.12) inset,
      0 26px 54px -22px rgba(0, 0, 0, 0.78);
  }
  .editor-card:hover::before {
    opacity: 1;
  }
  .editor-card:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  /* Avatar tile with a soft red halo behind it (teases the per-editor avatar glow). */
  .editor-card__avatar-wrap {
    position: relative;
    display: grid;
    place-items: center;
    margin-bottom: var(--space-3xs);
  }
  .editor-card__avatar-wrap::after {
    content: '';
    position: absolute;
    inset: -10%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-red) 42%, transparent),
      transparent 68%
    );
    filter: blur(10px);
    opacity: 0.5;
    z-index: 0;
    transition: opacity 0.25s ease;
  }
  .editor-card:hover .editor-card__avatar-wrap::after {
    opacity: 0.9;
  }
  .editor-card__avatar {
    position: relative;
    z-index: 1;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--color-white) 16%, transparent);
    background: var(--color-ink);
  }
  .editor-card__avatar--fallback {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--color-red-on-ink);
  }
  .editor-card__name {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: var(--type-card-title);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-white);
  }
  .editor-card__tagline {
    position: relative;
    z-index: 1;
    font-family: var(--font-body);
    font-size: var(--type-body);
    font-weight: 400;
    line-height: var(--lh-body);
    color: var(--color-white-dim);
  }
  /* Mono "enter" affordance — brand red, nudges on hover. */
  .editor-card__cta {
    position: relative;
    z-index: 1;
    margin-top: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-red-on-ink);
    transform: translateX(0);
    transition: transform 0.25s ease;
  }
  .editor-card:hover .editor-card__cta {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .editor-card,
    .editor-card::before,
    .editor-card__avatar-wrap::after,
    .editor-card__cta {
      transition: none;
    }
    .editor-card:hover {
      transform: none;
    }
    .editor-card:hover .editor-card__cta {
      transform: none;
    }
  }
</style>
