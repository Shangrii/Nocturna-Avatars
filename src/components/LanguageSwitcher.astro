---
/**
 * LanguageSwitcher (I18N-01, D-05/D-06; CHANGE 3 + CHANGE 4).
 *
 * A globe/translate-icon button showing the CURRENT locale code (EN / ES) that
 * opens a small dropdown to choose "English" / "Español" (each name written in
 * its own language). Picking a locale navigates to the COUNTERPART of the
 * current page in that locale, looked up by concept in the central route map
 * (NOT a naive prefix swap): on /en/services → Español yields /es/servicios.
 *
 * Accessibility: a real <button> with aria-haspopup/aria-expanded and an
 * aria-label; the menu is a list of <a> options each ≥44px; keyboard-operable;
 * closes on Escape / outside-click (wired in chrome.ts). Styles are tokenized
 * (no hard-coded brand hex).
 *
 * Each option carries data-lang-switch="<target>" so chrome.ts persists the
 * manual pick to localStorage('nocturna-lang') BEFORE navigation. Only the
 * literals 'es'/'en' are ever written (T-01-05).
 */
import { langCodes, languages, type Lang } from '../i18n/ui';
import { translatePath } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pathname = Astro.url.pathname;
const currentCode = lang.toUpperCase();
---

<div class="lang-switch" data-lang-menu>
  <button
    type="button"
    class="lang-trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={`Language: ${languages[lang]}`}
    data-lang-trigger
  >
    <svg
      class="lang-globe"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18" />
      <path d="M12 3c2.5 2.5 3.8 5.7 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z" />
    </svg>
    <span class="lang-code">{currentCode}</span>
    <svg
      class="lang-caret"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </button>

  <ul class="lang-menu" data-lang-list hidden>
    {
      langCodes.map((code) => (
        <li>
          <a
            class="lang-menu-opt"
            href={translatePath(pathname, code)}
            data-lang-switch={code}
            data-active={code === lang ? '' : undefined}
            aria-current={code === lang ? 'page' : undefined}
            hreflang={code}
            lang={code}
          >
            <span class="lang-menu-code">{code.toUpperCase()}</span>
            <span class="lang-menu-name">{languages[code]}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
