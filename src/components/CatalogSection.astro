---
/**
 * CatalogSection — modular service catalog rendered from services.json catalog[].
 *
 * Loops each category in the catalog array and renders:
 * - A section-tag + heading (uses global .section-header / .section-tag from sections.css)
 * - If category has items: editorial row list (<ul>/<li>) — name left, price right, 1px hairlines.
 *   Price sentinel "cotizar" (case-insensitive) renders as "Cotizar" in --color-red-on-paper.
 * - If category is empty: EmptyState with bilingual "Próximamente" / "Coming Soon" copy.
 *
 * All content is staff-edited JSON; Astro auto-escapes all rendered strings — T-03-04.
 * reveal class on animated containers picked up by existing GSAP ScrollTrigger (Phase 2 motion).
 */
import EmptyState from './EmptyState.astro';

interface CatalogItem {
  name: { es: string; en: string };
  price: string;
  id: string;           // required — unique slug from services.json
  repeatable?: boolean; // optional — omitted = false (toggle behavior)
}
interface CatalogCategory {
  id: string;
  category: { es: string; en: string };
  items: CatalogItem[];
}
interface Props {
  catalog: CatalogCategory[];
  lang: 'es' | 'en';
  /** Bilingual copy for EmptyState fallback (per-category). */
  emptyHeading: string;
  emptyBody: string;
  emptyTicketLabel: string;
  enableCart?: boolean; // when true, renders cart controls in each row
}

const { catalog, lang, emptyHeading, emptyBody, emptyTicketLabel, enableCart = false } = Astro.props;
---

{catalog.map((category) => (
  <div class="catalog-category" data-category={category.id}>
    <div class="section-header reveal">
      <span class="section-tag">{(category.category as { es: string; en: string })[lang]}</span>
      <h2 class="section-title">{(category.category as { es: string; en: string })[lang]}</h2>
    </div>

    {category.items.length === 0 ? (
      <div class="reveal">
        <EmptyState
          heading={emptyHeading}
          body={emptyBody}
          ticketLabel={emptyTicketLabel}
        />
      </div>
    ) : (
      <ul class="catalog-rows reveal" aria-label={(category.category as { es: string; en: string })[lang]}>
        {category.items.map((item) => {
          const isCotizar = item.price.toLowerCase() === 'cotizar';
          return (
            <li class={`catalog-row${enableCart ? ' catalog-row--interactive' : ''}`}
                data-item-id={enableCart ? item.id : undefined}>
              <span class="catalog-row__name">{(item.name as { es: string; en: string })[lang]}</span>
              <span class={`catalog-row__price${isCotizar ? ' catalog-row__price--cotizar' : ''}`}>
                {isCotizar ? 'Cotizar' : (enableCart ? `$${item.price}` : item.price)}
              </span>
              {enableCart && (
                item.repeatable
                  ? <div class="catalog-row__qty" role="group" aria-label={lang === 'es' ? `Cantidad: ${(item.name as { es: string; en: string })[lang]}` : `Quantity: ${(item.name as { es: string; en: string })[lang]}`}>
                      <button class="qty-btn qty-btn--dec" type="button" data-item-id={item.id} aria-label={lang === 'es' ? `Reducir cantidad de ${(item.name as { es: string; en: string })[lang]}` : `Decrease quantity of ${(item.name as { es: string; en: string })[lang]}`}>−</button>
                      <span class="qty-count" aria-live="polite">0</span>
                      <button class="qty-btn qty-btn--inc" type="button" data-item-id={item.id} aria-label={lang === 'es' ? `Aumentar cantidad de ${(item.name as { es: string; en: string })[lang]}` : `Increase quantity of ${(item.name as { es: string; en: string })[lang]}`}>+</button>
                    </div>
                  : <button class="catalog-row__cart-btn cart-add-trigger" type="button"
                            data-item-id={item.id}
                            aria-label={lang === 'es' ? `Agregar ${(item.name as { es: string; en: string })[lang]}` : `Add ${(item.name as { es: string; en: string })[lang]}`}>
                      {lang === 'es' ? 'Agregar' : 'Add'}
                    </button>
              )}
            </li>
          );
        })}
      </ul>
    )}
  </div>
))}

<style>
  /* Category wrapper — space between categories */
  .catalog-category {
    margin-bottom: var(--space-lg);
  }
  .catalog-category:last-child {
    margin-bottom: 0;
  }

  /* Row list container — centred, page-guttered, max-width editorial column */
  .catalog-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 1000px;
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  /* Individual row — flex, touch target, hairline separators */
  .catalog-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: var(--touch-min);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink-on-paper) 14%, transparent);
    transition: background 0.2s ease;
  }
  .catalog-row:first-child {
    border-top: 1px solid color-mix(in srgb, var(--color-ink-on-paper) 14%, transparent);
  }
  .catalog-row:hover {
    background: color-mix(in srgb, var(--color-ink-on-paper) 4%, transparent);
  }

  /* Name column — Inter body */
  .catalog-row__name {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 400;
    color: var(--color-ink-on-paper);
  }

  /* Price column — Space Mono, tabular, no-shrink */
  .catalog-row__price {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--color-ink-on-paper);
    flex-shrink: 0;
  }

  /* Cotizar sentinel — brand red, signals "contact us for pricing" */
  .catalog-row__price--cotizar {
    color: var(--color-red-on-paper);
  }

  /* Interactive row variant — cart controls present */
  .catalog-row--interactive {
    gap: var(--space-sm);
  }
  /* Name: flex:1, truncate on mobile */
  .catalog-row--interactive .catalog-row__name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* Price: no-shrink */
  .catalog-row--interactive .catalog-row__price {
    flex-shrink: 0;
  }
  /* Hide price on very narrow mobile — still visible in drawer */
  @media (max-width: 480px) {
    .catalog-row--interactive .catalog-row__price {
      display: none;
    }
  }
  /* Agregar / Quitar toggle button */
  .catalog-row__cart-btn {
    flex-shrink: 0;
    min-width: 80px;
    min-height: 32px;
    padding: 0 var(--space-xs);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-white-dim);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .catalog-row__cart-btn:hover,
  .catalog-row__cart-btn:focus-visible {
    border-color: var(--color-paper-on-ink);
    color: var(--color-paper-on-ink);
  }
  .catalog-row__cart-btn:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }
  /* Added state — item in cart */
  .catalog-row__cart-btn--added {
    border-color: var(--color-red-on-paper);
    color: var(--color-red-on-paper);
  }
  .catalog-row__cart-btn--added:hover,
  .catalog-row__cart-btn--added:focus-visible {
    background: var(--color-red-soft);
  }
  /* Qty control group */
  .catalog-row__qty {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    flex-shrink: 0;
  }
  .qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    min-height: 32px;
    font-family: var(--font-mono);
    font-size: 14px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-white-dim);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .qty-btn:hover, .qty-btn:focus-visible {
    border-color: var(--color-paper-on-ink);
    color: var(--color-paper-on-ink);
  }
  .qty-btn:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }
  .qty-count {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-ink-on-paper);
    min-width: 20px;
    text-align: center;
  }
</style>
